---
import { Image, Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';

import logo from '../assets/brand/logo.jpeg';

import content from '../data/content.json';

const WA = 'https://wa.me/5583993727554';

// Mesmo helper do Base.astro — monta caminhos a partir do BASE_URL em vez de
// hardcodar "/7gmag" (quebraria ao migrar pro domínio próprio).
const comBase = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

// ⚠️ TROCAR DEPOIS — e-mail que recebe os cadastros de revendedor.
// Hoje aponta para o e-mail do desenvolvedor, só pra testar o fluxo.
// Quando a Shirley/Edmilson definirem o e-mail oficial da 7G Mag (de
// preferência um alias tipo revenda@..., não uma caixa pessoal — o
// endereço fica exposto em HTML estático), trocar só esta linha.
const EMAIL_LEADS = 'chriscorrales29@gmail.com';

// Desativado a pedido do Christian pra apresentar sem o formulário de
// e-mail (o form action="mailto:" derruba Boas Práticas de 100 pra 77 no
// Lighthouse — Mixed Content — e depende do lead ter app de e-mail
// configurado). Código todo preservado abaixo; reativar é só virar isto
// pra `true`.
const FORM_EMAIL_ATIVO = false;

// ── Conteúdo editável pelo CMS (/admin) — vem de src/data/content.json ──
const { hero, features, catalogo, passos, depoimentos, faqs } = content;

// ── Catálogo dinâmico ──
// As fotos ficam em src/assets/products e são enviadas pelo CMS. O Astro
// otimiza tudo no build (WebP + srcset). O content.json guarda o caminho da
// foto; aqui resolvemos pelo nome do arquivo para o <Image> otimizar.
const productImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
function resolveProduto(caminho: string | undefined) {
  if (!caminho) return null;
  const nome = caminho.split('/').pop();
  const chave = Object.keys(productImages).find((k) => k.endsWith('/' + nome));
  return chave ? productImages[chave].default : null;
}

const produtos = (catalogo?.produtos ?? [])
  .map((p) => ({ img: resolveProduto(p.imagem), alt: p.alt }))
  .filter((p): p is { img: ImageMetadata; alt: string } => p.img !== null);

// A foto do topo (hero) tem seu próprio campo no CMS (hero.imagem/hero.alt) —
// independente do catálogo, para reordenar produtos não trocar o hero à toa.
const heroImg = resolveProduto(hero.imagem) ?? produtos[0]?.img ?? logo;
const heroAlt = hero.alt ?? produtos[0]?.alt ?? 'Produto 7G Mag em destaque';

// Vídeo do hero é opcional (campo hero.video no CMS, widget "file" — arquivo
// vai pra public/videos/, não passa pelo pipeline de otimização de imagem do
// Astro, então precisa chegar já comprimido). O CMS já grava o caminho com o
// prefixo /7gmag (mesma convenção do public_folder de uploads no config.yml).
// Se vazio, mostra a imagem normal. A imagem continua servindo de "poster"
// (capa) enquanto o vídeo carrega.
const heroVideo = hero.video || null;
const heroPoster = (await getImage({ src: heroImg, width: 900 })).src;

const navLinks = [
  { href: '#produtos', label: 'Produtos' },
  { href: '#revenda', label: 'Como funciona' },
  { href: '#depoimentos', label: 'Depoimentos' },
  { href: '#faq', label: 'Dúvidas' },
];
---

<Base>
  <div class="wrap">
    <!-- ── Nav ── -->
    <nav class="nav">
      <a class="nav-brand" href="#top">
        <Image class="logo" src={logo} alt="" width={40} height={40} />
        <span class="name">7G MAG</span>
      </a>

      <div class="nav-right">
        <div class="nav-links nav-links--desktop">
          {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>

        <a class="btn btn-primary nav-cta" href="#contato">Quero revender</a>

        <!-- Menu mobile sem JS: mesmo padrão do acordeão do FAQ. Sem aria-expanded
             de propósito — o <summary> já expõe role=button + estado nativamente,
             e um aria-expanded escrito à mão ficaria permanentemente desatualizado
             sem JS pra sincronizar. -->
        <details class="nav-menu">
          <summary class="nav-toggle" aria-label="Abrir menu de navegação">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
          </summary>
          <div class="nav-links nav-links--gaveta">
            {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </details>
      </div>
    </nav>

    <main>
    <!-- ── Hero ── -->
    <header id="top" class="section section--hero">
      <div class="hero-grid">
        <div>
          <span class="tag tag-accent">{hero.tag}</span>
          <h1 class="hero-title">
            {hero.titulo}
          </h1>
          <p class="lead hero-lead">
            {hero.texto}
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="#contato">{hero.cta_primario}</a>
            <a class="btn btn-secondary" href={WA} target="_blank" rel="noopener">{hero.cta_secundario}</a>
          </div>
        </div>
        <div class="plate hero-plate">
          {heroVideo ? (
            <video
              class="hero-video"
              poster={heroPoster}
              muted
              loop
              playsinline
              preload="metadata"
              data-autoplay-respeita-reduced-motion
            >
              <source src={heroVideo} type="video/mp4" />
            </video>
          ) : (
            <Picture
              src={heroImg}
              alt={heroAlt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[400, 640, 900, 1280]}
              sizes="(min-width:1360px) 544px, (min-width:960px) 40vw, 100vw"
              width={1280}
              loading="eager"
            />
          )}
        </div>
      </div>
    </header>

    {heroVideo && (
      <script is:inline>
        (function () {
          var video = document.querySelector('[data-autoplay-respeita-reduced-motion]');
          if (!video) return;
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            video.play().catch(function () {
              /* autoplay bloqueado pelo navegador — fica parado no poster, sem quebrar nada */
            });
          }
        })();
      </script>
    )}

    <!-- ── Diferenciais ── -->
    <section class="section">
      <div class="features-grid">
        {features.map((f) => (
          <div>
            <div class="feature-title">{f.titulo}</div>
            <p class="feature-p">{f.texto}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Produtos ── -->
    <section id="produtos" class="section">
      <div class="kicker">{catalogo.kicker}</div>
      <h2 class="h2">{catalogo.titulo}</h2>
      <p class="lead">{catalogo.subtitulo}</p>
      <div class="produtos-grid">
        {produtos.map((prod) => (
          <div class="plate plate--quadrado">
            <Image
              src={prod.img}
              alt={prod.alt}
              widths={[280, 400, 560, 700]}
              sizes="(min-width:1360px) 316px, (min-width:960px) 25vw, (min-width:720px) 33vw, 50vw"
              width={700}
              quality={70}
            />
          </div>
        ))}
        <a href="#novidades" class="plate plate--quadrado plate--mais" aria-haspopup="dialog">
          <div class="plate-more">
            <div class="plate-more-title">+ novidades</div>
            <p>a cada coleção</p>
          </div>
        </a>
      </div>
    </section>

    <!--
      Modal "+ novidades" — CSS puro via :target (mesmo espírito do FAQ/
      hambúrguer, zero JS). Limitação conhecida: sem JS não dá pra
      gerenciar foco/aria-hidden dinamicamente como um <dialog> de
      verdade faria — aceitável aqui pelo mesmo motivo do hambúrguer sem
      aria-expanded (documentado em Base.astro/global.css).

      Conteúdo é PLACEHOLDER a pedido do Christian — Shirley/Edmilson vão
      complementar com fotos e specs reais depois.
    -->
    <div id="novidades" class="modal" role="dialog" aria-modal="true" aria-labelledby="novidades-titulo">
      <a href="#produtos" class="modal-fundo" aria-label="Fechar"></a>
      <div class="modal-conteudo card elev-sm">
        <a href="#produtos" class="modal-fechar" aria-label="Fechar">×</a>
        <div class="kicker">Prévia</div>
        <h3 id="novidades-titulo" class="h2 modal-titulo">Mais novidades da coleção</h3>
        <p class="lead">Novas cores e modelos chegando a cada lançamento — dá uma espiada em mais fotos e nos detalhes técnicos da linha.</p>

        <div class="modal-galeria">
          {produtos.slice(0, 4).map((prod) => (
            <div class="plate plate--quadrado">
              <Image src={prod.img} alt={prod.alt} widths={[200, 280]} sizes="140px" />
            </div>
          ))}
        </div>

        <h4 class="modal-subtitulo">Detalhes técnicos</h4>
        <dl class="modal-specs">
          <div><dt>Material</dt><dd>Verniz sintético e tecido respirável</dd></div>
          <div><dt>Tecnologia magnética</dt><dd>Ímãs terapêuticos embutidos no solado</dd></div>
          <div><dt>Peso aproximado</dt><dd>320g o par (varia por modelo)</dd></div>
          <div><dt>Cores disponíveis</dt><dd>6 cores por coleção</dd></div>
          <div><dt>Garantia</dt><dd>90 dias contra defeito de fabricação</dd></div>
        </dl>
        <p class="form-hint">* Fotos e especificações de exemplo — em atualização com os dados reais dos produtos.</p>
      </div>
    </div>

    <!-- ── Como funciona ── -->
    <section id="revenda" class="section">
      <div class="kicker">Como funciona</div>
      <h2 class="h2">De revendedor a negócio próprio, em 3 passos</h2>
      <div class="passos-grid">
        {passos.map((p) => (
          <div>
            <div class="passo-num">{p.numero}</div>
            <div class="passo-title">{p.titulo}</div>
            <p class="passo-p">{p.texto}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Depoimentos ── -->
    <section id="depoimentos" class="section">
      <div class="kicker">Depoimentos</div>
      <h2 class="h2">Quem já revende 7G Mag</h2>
      <div class="depo-grid">
        {depoimentos.map((d) => (
          <figure class="card">
            <blockquote class="card-body">"{d.texto}"</blockquote>
            <figcaption class="card-meta">{d.autor}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ── FAQ (acordeão sem JS) ── -->
    <section id="faq" class="section section--estreita">
      <div class="kicker">Dúvidas frequentes</div>
      <h2 class="h2">Perguntas de quem está começando</h2>
      <div class="faq">
        {faqs.map((f, i) => {
          // Destaque pontual pra pergunta sobre a tecnologia magnética — casa
          // pelo texto porque o FAQ é genérico (editável pelo CMS); se a
          // pergunta for reescrita no painel, o destaque some sozinho até
          // alguém atualizar este texto aqui também.
          const destaque = f.pergunta === 'Como funciona a tecnologia magnética?';
          return (
            <details open={i === 0} class={destaque ? 'faq-destaque' : undefined}>
              <summary>
                <span class="faq-pergunta">
                  {destaque && <span class="tag tag-accent faq-badge">Mais perguntada</span>}
                  {f.pergunta}
                </span>
              </summary>
              <p>
                {f.resposta}
                {destaque && (
                  <>
                    {' '}
                    <a href={comBase('sobre-magnetoterapia/')} target="_blank" rel="noopener">Saiba mais →</a>
                  </>
                )}
              </p>
            </details>
          );
        })}
      </div>
    </section>

    <!-- ── Contato ── -->
    <section id="contato" class="section">
      <div class={FORM_EMAIL_ATIVO ? 'contato-grid' : 'contato-grid contato-grid--simples'}>
        <div>
          <div class="kicker">Cadastro de revendedor</div>
          <h2 class="h2">Quero ser revendedor 7G Mag</h2>
          <p class="lead lead--contato">
            {FORM_EMAIL_ATIVO
              ? 'Preencha seus dados e nossa equipe entra em contato para explicar as condições de revenda. Prefere algo mais rápido? Chame direto no WhatsApp.'
              : 'Fale direto com a gente no WhatsApp e nossa equipe já te explica as condições de revenda.'}
          </p>
          <a
            class={FORM_EMAIL_ATIVO ? 'btn btn-secondary btn-contato' : 'btn btn-primary btn-contato'}
            href={WA}
            target="_blank"
            rel="noopener"
          >
            Falar agora no WhatsApp
          </a>
        </div>
        {FORM_EMAIL_ATIVO && (
        <div class="card elev-sm card-form">
          <!--
            Sem backend: o formulário abre o app de e-mail do lead com o
            cadastro já preenchido (assunto + corpo). method=post + enctype=
            text/plain é o fallback sem JS (funciona nativamente em Firefox/
            Chrome/Safari); o script logo abaixo monta uma mensagem legível
            e assume o clique quando há JS.

            ⚠️ Custo conhecido: action="mailto:" faz o Chrome acusar Mixed
            Content num form dentro de página https — derruba Boas Práticas
            de 100 pra 77 no Lighthouse (nada inseguro de verdade é
            transmitido, é só o aviso do navegador pra scheme não-https).
          -->
          <form
            id="form-revenda"
            class="form-revenda"
            method="post"
            enctype="text/plain"
            action={`mailto:${EMAIL_LEADS}`}
            data-destino={EMAIL_LEADS}
          >
            <div class="field"><label for="nome">Nome completo</label><input id="nome" class="input" type="text" name="nome" required placeholder="Seu nome" autocomplete="name" autocapitalize="words" /></div>
            <div class="field"><label for="email">E-mail</label><input id="email" class="input" type="email" name="email" required placeholder="seu@email.com" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" /></div>
            <div class="field"><label for="tel">Telefone / WhatsApp</label><input id="tel" class="input" type="tel" name="telefone" required placeholder="(00) 00000-0000" autocomplete="tel" inputmode="tel" /></div>
            <div class="field"><label for="cidade">Cidade</label><input id="cidade" class="input" type="text" name="cidade" required placeholder="Sua cidade" autocomplete="address-level2" autocapitalize="words" /></div>

            <button class="btn btn-primary btn-block" type="submit">Enviar cadastro por e-mail</button>

            <p class="form-hint">
              Ao enviar, abrimos o aplicativo de e-mail do seu celular com a mensagem já pronta — é só tocar em
              <strong>enviar</strong> lá.
            </p>

            <div id="form-retorno" class="form-retorno" role="status" tabindex="-1" hidden>
              <strong>Pronto! Abrimos seu aplicativo de e-mail com o cadastro preenchido.</strong>
              <p>
                Não abriu nada? Sem problema: fale com a gente no
                <a href={WA} target="_blank" rel="noopener">WhatsApp</a>
                ou escreva para <a href={`mailto:${EMAIL_LEADS}`}>{EMAIL_LEADS}</a>.
              </p>
            </div>

            <noscript>
              <p class="form-hint">
                Seu navegador está sem JavaScript. O botão acima ainda abre seu programa de e-mail, mas se preferir
                fale no <a href={WA} target="_blank" rel="noopener">WhatsApp</a>.
              </p>
            </noscript>
          </form>

          <script is:inline>
            (function () {
              var form = document.getElementById('form-revenda');
              if (!form) return;
              var retorno = document.getElementById('form-retorno');

              form.addEventListener('submit', function (evento) {
                evento.preventDefault();

                var dados = new FormData(form);
                var v = function (campo) { return String(dados.get(campo) || '').trim(); };

                var assunto = 'Quero ser revendedor 7G Mag - ' + v('nome');
                var corpo =
                  'Nome: ' + v('nome') + '\n' +
                  'E-mail: ' + v('email') + '\n' +
                  'Telefone/WhatsApp: ' + v('telefone') + '\n' +
                  'Cidade: ' + v('cidade') + '\n\n' +
                  'Cadastro enviado pelo site da 7G Mag.';

                if (retorno) {
                  retorno.hidden = false;
                  retorno.focus();
                }

                window.location.href =
                  'mailto:' + form.dataset.destino +
                  '?subject=' + encodeURIComponent(assunto) +
                  '&body=' + encodeURIComponent(corpo);
              });
            })();
          </script>
        </div>
        )}
      </div>
    </section>
    </main>

    <!-- ── Footer ── -->
    <footer class="section site-footer">
      <div class="footer-brand">
        <Image class="footer-logo" src={logo} alt="7G Mag" width={32} height={32} />
        <span class="footer-copy">© 2026 7G Mag. Todos os direitos reservados.</span>
      </div>
      <a href="https://www.instagram.com/oficial7gmag" target="_blank" rel="noopener">@oficial7gmag</a>
    </footer>
  </div>

  <!-- ── WhatsApp flutuante ── -->
  <a class="wa-float" href={WA} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.14.82.84-3.06-.2-.31a8.18 8.18 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.26-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.55-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.24-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.24.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.47-.01a.9.9 0 0 0-.66.31c-.23.24-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.57.12.16 1.75 2.67 4.24 3.75.59.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/></svg>
    <span class="rotulo">WhatsApp</span>
  </a>
</Base>
